\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Complete QA-DR-MADDPG\ architecture. Vehicle, RSU, and UAV actors use role-local observations at execution time, whereas centralized critics and the shared replay buffer are active only during training. The feasibility controller separates neural proposals from physically executed actions.}}{11}{figure.caption.23}\protected@file@percent }
\newlabel{fig:controller_architecture}{{5}{11}{Complete \method \ architecture. Vehicle, RSU, and UAV actors use role-local observations at execution time, whereas centralized critics and the shared replay buffer are active only during training. The feasibility controller separates neural proposals from physically executed actions}{figure.caption.23}{}}
